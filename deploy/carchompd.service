[Unit]
Description=CarChomp daemon
After=postgresql.service gpsd.service network.target
Wants=postgresql.service

[Service]
User=carchomp
ExecStart=/usr/local/bin/carchompd /etc/carchomp/carchompd.toml
Restart=always
RestartSec=2
# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/carchomp

[Install]
WantedBy=multi-user.target
