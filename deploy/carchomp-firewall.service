[Unit]
Description=CarChomp firewall: drop inbound traffic the car does not serve
# Up before any network is (like Debian's nftables.service), without
# touching other tables: NetworkManager keeps its hotspot NAT rules.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/carchomp/firewall.nft
ExecStop=/usr/sbin/nft delete table inet carchomp

[Install]
WantedBy=sysinit.target
